    [l] (n=9)&(b10=0) -> bias_l : (n'=1) + (1-bias_l) : (n'=10)&(b10'=1);
    [u] (n=9)&(b10=0) -> bias_u : (n'=1) + (1-bias_u) : (n'=10)&(b10'=1);
