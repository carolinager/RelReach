    [l] (n=14)&(b15=0) -> bias_l : (n'=15) + (1-bias_l) : (n'=15)&(b15'=1);
    [u] (n=14)&(b15=0) -> bias_u : (n'=15) + (1-bias_u) : (n'=15)&(b15'=1);
