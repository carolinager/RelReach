// Rejection Sampling
// biased coins

mdp

const int N=20000; // N > 0, the algorithm samples uniformly from {0, ..., N-1}

const double bias_l = 59/100; // lower bound for bias towards 0
const double bias_u = 61/100; // upper bound for bias towards 0

module main
    n : [0..15] init 0;
    b1 : [0..1] init 0;
    b2 : [0..1] init 0;
    b3 : [0..1] init 0;
    b4 : [0..1] init 0;
    b5 : [0..1] init 0;
    b6 : [0..1] init 0;
    b7 : [0..1] init 0;
    b8 : [0..1] init 0;
    b9 : [0..1] init 0;
    b10 : [0..1] init 0;
    b11 : [0..1] init 0;
    b12 : [0..1] init 0;
    b13 : [0..1] init 0;
    b14 : [0..1] init 0;
    b15 : [0..1] init 0;
