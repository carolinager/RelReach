// Rejection Sampling
// biased coins

mdp

const int N=100; // N > 0, the algorithm samples uniformly from {0, ..., N-1}

const double bias_l = 59/100; // lower bound for bias towards 0
const double bias_u = 61/100; // upper bound for bias towards 0

module main
    n : [0..7] init 0;
    b1 : [0..1] init 0;
    b2 : [0..1] init 0;
    b3 : [0..1] init 0;
    b4 : [0..1] init 0;
    b5 : [0..1] init 0;
    b6 : [0..1] init 0;
    b7 : [0..1] init 0;
    [l] (n=0)&(b1=0)&(b2=0)&(b3=0)&(b4=0)&(b5=0)&(b6=0)&(b7=0) -> bias_l : (n'=1) + (1-bias_l) : (n'=1)&(b1'=1);
    [u] (n=0)&(b1=0)&(b2=0)&(b3=0)&(b4=0)&(b5=0)&(b6=0)&(b7=0) -> bias_u : (n'=1) + (1-bias_u) : (n'=1)&(b1'=1);
    [l] (n=1)&(b2=0)&(b3=0)&(b4=0)&(b5=0)&(b6=0)&(b7=0) -> bias_l : (n'=2) + (1-bias_l) : (n'=2)&(b2'=1);
    [u] (n=1)&(b2=0)&(b3=0)&(b4=0)&(b5=0)&(b6=0)&(b7=0) -> bias_u : (n'=2) + (1-bias_u) : (n'=2)&(b2'=1);
    [l] (n=2)&(b3=0)&(b4=0)&(b5=0)&(b6=0)&(b7=0) -> bias_l : (n'=3) + (1-bias_l) : (n'=3)&(b3'=1);
    [u] (n=2)&(b3=0)&(b4=0)&(b5=0)&(b6=0)&(b7=0) -> bias_u : (n'=3) + (1-bias_u) : (n'=3)&(b3'=1);
    [l] (n=3)&(b4=0)&(b5=0)&(b6=0)&(b7=0) -> bias_l : (n'=4) + (1-bias_l) : (n'=4)&(b4'=1);
    [u] (n=3)&(b4=0)&(b5=0)&(b6=0)&(b7=0) -> bias_u : (n'=4) + (1-bias_u) : (n'=4)&(b4'=1);
    [l] (n=4)&(b5=0)&(b6=0)&(b7=0) -> bias_l : (n'=5) + (1-bias_l) : (n'=5)&(b5'=1);
    [u] (n=4)&(b5=0)&(b6=0)&(b7=0) -> bias_u : (n'=5) + (1-bias_u) : (n'=5)&(b5'=1);
    [l] (n=5)&(b6=0)&(b7=0) -> bias_l : (n'=6) + (1-bias_l) : (n'=6)&(b6'=1);
    [u] (n=5)&(b6=0)&(b7=0) -> bias_u : (n'=6) + (1-bias_u) : (n'=6)&(b6'=1);
    [l] (n=6)&(b7=0) -> bias_l : (n'=7) + (1-bias_l) : (n'=7)&(b7'=1);
    [u] (n=6)&(b7=0) -> bias_u : (n'=7) + (1-bias_u) : (n'=7)&(b7'=1);
